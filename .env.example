# ScreenMaster local secrets — copy to `.env` and fill in. `.env` is gitignored; never commit it.
# Docker Compose auto-loads a root `.env`, substituting ${VAR} in compose.yaml.

# --- TMDB (Catalog sync) --------------------------------------------------------------------------
# TMDB v4 "API Read Access Token" (the long eyJ... token, NOT the short v3 api_key). Sent by the
# catalog service as `Authorization: Bearer <token>`. Get one at:
#   https://www.themoviedb.org/settings/api  (copy "API Read Access Token")
TMDB_API_KEY=

# Turn the scheduled catalog sync on. Left false by default so `docker compose up` works with no
# token; set to true (with TMDB_API_KEY above) to fill catalog-db from TMDB.
TMDB_SYNC_ENABLED=false

# --- Payment gateways (Payment service) ---------------------------------------------------------
# SANDBOX / TEST CREDENTIALS ONLY. A live Stripe key (sk_live_*) is rejected at startup unless
# spring.profiles.active=production — this repo should be incapable of moving real money.
#
# Leave a pair empty to disable that gateway: the adapter is not registered, so it is never
# offered by GET /payments/gateways and never selectable.

# Stripe test mode — https://dashboard.stripe.com/test/apikeys (settles USD)
STRIPE_SECRET_KEY=
# Printed by `stripe listen --forward-to localhost:8080/api/payments/webhooks/stripe` (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Paymob sandbox — https://accept.paymob.com (settles EGP)
# api-key + hmac from Settings > Account Info; integration-id and iframe-id from
# Developers > Payment Integrations and Developers > iframes respectively.
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=

# Public base URL the gateways send webhooks to. Gateways cannot reach localhost, so in local dev
# this is a tunnel: `ngrok http 8080` for Paymob; the Stripe CLI forwards directly for Stripe.
PAYMENT_PUBLIC_URL=http://localhost:8080

# The controllable SandboxGateway (successor to FAIL_RATE) — always registered, signs its own
# webhooks. Drives the Phase 3.7 failure script and the Phase 5 circuit-breaker demo.
PAYMENT_SANDBOX_FAILURE_RATE=0.0       # fraction of checkouts that decline  [0.0 - 1.0]
PAYMENT_SANDBOX_UNAVAILABLE_RATE=0.0   # fraction of session calls that time out (breaker demo)
PAYMENT_SANDBOX_LATENCY_MILLIS=300
PAYMENT_SANDBOX_SESSION_TTL=PT10M
# Signs the sandbox's own webhooks. Any non-empty value works locally; it never leaves this machine.
PAYMENT_SANDBOX_WEBHOOK_SECRET=sandbox-local-development-secret

# --- Keycloak / Phase 7 (edge auth + zero trust) -------------------------------------------------
# Console admin for the Keycloak container itself (NOT an app user — alice/admin live in the realm).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# This service's OWN identity toward Keycloak (client-credentials for the notification-svc client).
# Dev default matches the DEV realm JSON (keycloak/realms/cinema-realm.json); set a real secret here.
NOTIFICATION_SVC_SECRET=notification-svc-dev-secret
# The ONE issuer URI every service pins (must equal the `iss` Keycloak mints via KC_HOSTNAME).
# The default is the in-Compose address; override only if Keycloak lives elsewhere.
KEYCLOAK_ISSUER_URI=http://keycloak:8180/realms/cinema

# --- Notification email (Phase 4.3b — the ticket email) ------------------------------------------
# SMTP. Defaults point at the Mailpit container: fake SMTP on 1025, web inbox on
# http://localhost:8025 — open that to LOOK at the rendered ticket.
#
# Switching to a real provider (SES / SendGrid / Gmail) is a CONFIG change with ZERO code change —
# that is the whole reason delivery goes through JavaMailSender rather than a provider SDK. For a
# real provider: set the host/port, fill in the credentials, and flip both flags to true.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# The From: identity on every ticket. A real provider only accepts a domain you are authorised for.
NOTIFICATION_MAIL_FROM=tickets@screenmaster.local
NOTIFICATION_MAIL_FROM_NAME=ScreenMaster

# Poster images. Catalog snapshots TMDB *paths* ("/abc.jpg"); the email composes
# {base}/{size}{path} at render time, so changing image width never means re-syncing data.
# Keep the base in step with TMDB_IMAGE_BASE_URL above.
NOTIFICATION_IMAGE_BASE_URL=https://image.tmdb.org/t/p
NOTIFICATION_IMAGE_POSTER_SIZE=w780

# How long a recipient's email address is cached after being looked up from Keycloak. Short enough
# that a changed address takes effect the same session; long enough that a burst of bookings costs
# one Admin API call rather than one per booking.
NOTIFICATION_EMAIL_CACHE_TTL=10m
NOTIFICATION_EMAIL_CACHE_MAX_SIZE=10000
