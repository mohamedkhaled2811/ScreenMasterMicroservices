<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.gr74</groupId>
		<artifactId>screenmaster-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>booking</artifactId>
	<name>booking</name>
	<description>Booking service — showtimes, seats, bookings; the core saga (owns booking-db).</description>

	<!--
	  The core service (absorbs Theater + Scheduling). Owns booking-db. Serves REST (web-mvc),
	  persists with JPA (schema owned by Liquibase, ddl-auto=validate), and calls Payment / Catalog
	  synchronously via RestClient. The saga, outbox, and resilience wiring land in Phases 3-5; AMQP
	  for the outbox relay is added in Phase 4. Real tables + endpoints arrive in Phase 3 — for now
	  the Liquibase changelog is empty (just wires the tool) and the app boots against an empty schema.
	-->
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!--
		  Bean Validation (Hibernate Validator). Powers @Valid on the inventory/showtime request DTOs
		  (@NotBlank name, @Positive seat number, @DecimalMin price, ...) so bad input is a coded 400
		  before the service runs — not pulled in transitively by web-mvc, so declared explicitly here
		  exactly as payment/ does.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!--
		  Distributed tracing (Phase 6, decision A1). Micrometer Tracing is a facade; this is the
		  OpenTelemetry bridge (NOT Brave — the vendor-neutral standard, see docs/concepts/observability.md),
		  and the Zipkin exporter ships finished spans to the Zipkin in compose.yaml (port 9411).
		  The log pattern has carried %X{traceId}/%X{spanId} since Phase 1; these jars are what make
		  the ids appear. Versions are managed by the Spring Boot parent (micrometer-tracing + OTel
		  BOMs) — no pin here.
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-otel</artifactId>
		</dependency>
		<dependency>
			<groupId>io.opentelemetry</groupId>
			<artifactId>opentelemetry-exporter-zipkin</artifactId>
		</dependency>
		<!--
		  Boot 4's tracing auto-configuration ships in its own artifact (it was split out of the
		  actuator jar, like the Liquibase one below): without it the bridge+exporter above sit on
		  the classpath but no Tracer bean is created and %X{traceId} stays empty. This is the
		  targeted auto-config module (NOT spring-boot-starter-opentelemetry, which would drag in an
		  OTLP exporter and registry we do not use — we ship spans to Zipkin).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
		</dependency>
		<!--
		  The Zipkin *sender*. The auto-config above only builds the ZipkinSpanExporter when a
		  BytesMessageSender bean already exists (@ConditionalOnBean) — and in Boot 4 that bean comes
		  from this separate module, which reads management.zipkin.tracing.endpoint and wires the
		  okhttp sender. Without it the condition silently never matches: spans are still recorded and
		  %X{traceId} still fills in, but nothing is ever shipped and Zipkin stays empty. Having
		  zipkin-sender-okhttp3 on the classpath transitively is NOT enough — a library is not a bean.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-zipkin</artifactId>
		</dependency>
		<!--
		  AspectJ AOP so @Observed (Phase 6, decision D2 — BookingService.create, OutboxRelay.drain)
		  has its aspect: ObservedAspect is a real @Aspect and needs aspectjweaver, and without it the
		  annotation is silently inert. Boot 4 renamed spring-boot-starter-aop to
		  spring-boot-starter-aspectj. Payment already carries this via the resilience4j starter.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aspectj</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-restclient</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>

		<!--
		  AMQP / RabbitMQ. Booking is the CONSUMER side of the CQRS read model (BUILD_PLAN 2.3, way B):
		  a @RabbitListener consumes MovieUpserted and keeps a local movie_projections cache so "my bookings"
		  can name movies by a local join even when Catalog is down. Version managed by the Spring Boot
		  parent. See docs/concepts/rabbitmq.md, docs/concepts/idempotent-consumer.md, cqrs-read-model.md.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>

		<!--
		  OpenAPI 3.1 spec + Swagger UI. Introspects the inventory + showtime controllers and their
		  record DTOs / filter params at runtime; serves /v3/api-docs and /swagger-ui.html. Version
		  managed in the parent pom. See concepts/openapi-springdoc.md.
		-->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
		</dependency>

		<!--
		  Spring Boot 4 moved each integration's auto-configuration out of the umbrella
		  spring-boot-autoconfigure jar into its own module. spring-boot-liquibase carries
		  LiquibaseAutoConfiguration (the bean that runs the changelog on startup) and pulls in
		  liquibase-core transitively. Without it, liquibase-core is on the classpath but never
		  runs — the schema is never created and Hibernate's ddl-auto=validate fails with
		  "missing table [...]". See docs/concepts/liquibase.md.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-liquibase</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  Spring Boot 4 split the test slices out of spring-boot-test-autoconfigure into per-technology
		  modules. spring-boot-webmvc-test carries @WebMvcTest (the controller slices);
		  spring-boot-data-jpa-test carries @DataJpaTest and pulls in TestEntityManager (the
		  repository slices). Without them the slice annotations aren't on the classpath. Mirrors catalog.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- TEST SCOPE ONLY: in-memory DB so the contextLoads test needs no running Postgres. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!--
	  Repackages the module into a runnable jar (Lombok-exclude config inherited from the
	  parent's pluginManagement). Safe now that BookingApplication exists.
	-->
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
