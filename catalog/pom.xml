<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.gr74</groupId>
		<artifactId>screenmaster-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>catalog</artifactId>
	<name>catalog</name>
	<description>Catalog service — movies, genres (owns catalog-db).</description>

	<!--
	  Owns the movie catalogue and its own Postgres (catalog-db). It serves REST (web-mvc) and
	  persists with JPA; the schema is owned by Liquibase (ddl-auto=validate), not Hibernate.
	  Registers with Eureka so the gateway and Booking can find it. Real tables + endpoints arrive
	  in Phase 2 (2.1) — for now the Liquibase changelog is empty (just wires the tool) and the app
	  boots against an empty schema.
	-->
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!--
		  Bean Validation (Jakarta + Hibernate Validator). Consistent with payment; powers the
		  @Valid/@NotNull constraints on the (future) write paths and the validation branch of
		  GlobalExceptionHandler. No constraint is enforced on the read endpoint yet, but the advice
		  that renders validation failures as ProblemDetail lives here.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!--
		  Distributed tracing. Micrometer Tracing is a facade; this is the
		  OpenTelemetry bridge (NOT Brave — the vendor-neutral standard, see docs/concepts/observability.md),
		  and the Zipkin exporter ships finished spans to the Zipkin in compose.yaml (port 9411).
		  The log pattern already carries %X{traceId}/%X{spanId}; these jars are what make
		  the ids appear. Versions are managed by the Spring Boot parent (micrometer-tracing + OTel
		  BOMs) — no pin here.
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-otel</artifactId>
		</dependency>
		<dependency>
			<groupId>io.opentelemetry</groupId>
			<artifactId>opentelemetry-exporter-zipkin</artifactId>
		</dependency>
		<!--
		  Boot 4's tracing auto-configuration ships in its own artifact (it was split out of the
		  actuator jar): without it the bridge+exporter above sit on the classpath but no Tracer bean
		  is created and %X{traceId} stays empty. This is the targeted auto-config module (NOT
		  spring-boot-starter-opentelemetry, which would drag in an OTLP exporter and registry we do
		  not use — we ship spans to Zipkin).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
		</dependency>
		<!--
		  The Zipkin *sender*. The auto-config above only builds the ZipkinSpanExporter when a
		  BytesMessageSender bean already exists (@ConditionalOnBean) — and in Boot 4 that bean comes
		  from this separate module, which reads management.zipkin.tracing.endpoint and wires the
		  okhttp sender. Without it the condition silently never matches: spans are still recorded and
		  %X{traceId} still fills in, but nothing is ever shipped and Zipkin stays empty. Having
		  zipkin-sender-okhttp3 on the classpath transitively is NOT enough — a library is not a bean.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-zipkin</artifactId>
		</dependency>
		<!--
		  Synchronous HTTP client for calling TMDB from the @Scheduled sync job. RestClient (not
		  WebClient): the sync runs on a scheduler thread where blocking is fine, and it keeps one
		  HTTP-client story across services (Booking → Payment/Catalog also uses RestClient). See
		  docs/concepts/sync-vs-async-comms.md.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-restclient</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>
		<!--
		  Phase 7 (BUILD_PLAN 7.3): zero trust — Catalog validates the Bearer JWT itself instead of
		  trusting the gateway's word. Reads stay public (a cinema's listing is browsable without
		  login — decision B2a); anything else needs an authenticated token. The realm roles land
		  via a custom converter (Keycloak puts them in realm_access.roles, not scope).
		  Version managed by the Spring Boot parent. See docs/concepts/security-jwt-oauth2.md.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>

		<!--
		  AMQP / RabbitMQ. Catalog is the PUBLISHER side of the CQRS read model (BUILD_PLAN 2.3, way B):
		  after a movie row is (re)hydrated on the incremental-refresh path it emits a MovieUpserted event
		  that Booking consumes to keep a local title cache. Publish is deferred to AFTER_COMMIT and fires
		  ONLY from the change-feed refresh, never from backfill — see ADR 0001. Version managed by the
		  Spring Boot parent. See docs/concepts/rabbitmq.md, docs/concepts/cqrs-read-model.md.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>

		<!--
		  OpenAPI 3.1 spec + Swagger UI. Introspects MovieController + its record DTOs and the
		  MovieFilter query params at runtime; serves /v3/api-docs and /swagger-ui.html. Version
		  managed in the parent pom. See concepts/openapi-springdoc.md.
		-->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
		</dependency>

		<!--
		  Spring Boot 4 moved each integration's auto-configuration out of the umbrella
		  spring-boot-autoconfigure jar into its own module. spring-boot-liquibase carries
		  LiquibaseAutoConfiguration (the bean that runs the changelog on startup) and pulls in
		  liquibase-core transitively. Without it, liquibase-core is on the classpath but never
		  runs — the schema is never created and Hibernate's ddl-auto=validate fails with
		  "missing table [...]". See docs/concepts/liquibase.md.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-liquibase</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  Phase 7: spring-security-test provides the jwt() MockMvc post-processor, so slice tests
		  exercise the REAL filter chain with a forged JWT instead of bypassing security.
		-->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  Boot 4 moved TestRestTemplate out of spring-boot-test into this module
		  (org.springframework.boot.resttestclient.TestRestTemplate) — the Boot-3 import path no
		  longer exists. Used by the full-context actuator/health tests (real HTTP, no MockMvc).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-resttestclient</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  Spring Boot 4 split the test slices out of spring-boot-test-autoconfigure into per-technology
		  modules. spring-boot-webmvc-test carries @WebMvcTest (the MovieController slice);
		  spring-boot-data-jpa-test carries @DataJpaTest and pulls in TestEntityManager (the
		  MovieRepository slice). Without them the slice annotations aren't on the classpath.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- TEST SCOPE ONLY: in-memory DB so the slice/contextLoads tests need no running Postgres. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!--
	  Repackages the module into a runnable jar (Lombok-exclude config inherited from the
	  parent's pluginManagement). Safe now that CatalogApplication exists.
	-->
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
