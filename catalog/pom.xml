<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.gr74</groupId>
		<artifactId>screenmaster-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>catalog</artifactId>
	<name>catalog</name>
	<description>Catalog service — movies, genres (owns catalog-db).</description>

	<!--
	  Owns the movie catalogue and its own Postgres (catalog-db). It serves REST (web-mvc) and
	  persists with JPA; the schema is owned by Liquibase (ddl-auto=validate), not Hibernate.
	  Registers with Eureka so the gateway and Booking can find it. Real tables + endpoints arrive
	  in Phase 2 (2.1) — for now the Liquibase changelog is empty (just wires the tool) and the app
	  boots against an empty schema.
	-->
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>

		<!--
		  Spring Boot 4 moved each integration's auto-configuration out of the umbrella
		  spring-boot-autoconfigure jar into its own module. spring-boot-liquibase carries
		  LiquibaseAutoConfiguration (the bean that runs the changelog on startup) and pulls in
		  liquibase-core transitively. Without it, liquibase-core is on the classpath but never
		  runs — the schema is never created and Hibernate's ddl-auto=validate fails with
		  "missing table [...]". See docs/concepts/liquibase.md.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-liquibase</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- TEST SCOPE ONLY: in-memory DB so the contextLoads test needs no running Postgres. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!--
	  Repackages the module into a runnable jar (Lombok-exclude config inherited from the
	  parent's pluginManagement). Safe now that CatalogApplication exists.
	-->
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
