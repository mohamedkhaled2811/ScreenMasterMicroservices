<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.gr74</groupId>
		<artifactId>screenmaster-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>discovery</artifactId>
	<name>discovery</name>
	<description>Eureka service-discovery server.</description>

	<!--
	  The registry every other service talks to. It runs the Eureka SERVER
	  (not the client), so it pulls the server starter only.
	  Runnable since BUILD_PLAN 1.1: DiscoveryApplication is the @EnableEurekaServer
	  boot app, and the spring-boot-maven-plugin (below) repackages it into a jar.
	-->
	<dependencies>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-server</artifactId>
		</dependency>

		<!--
		  Actuator for /actuator/health — a probe surface for Compose even on the registry.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!--
		  Distributed tracing. The Eureka registration chatter is deliberately
		  NOT traced (no @Observed, no outbox here), but discovery shares the tracing starters so its
		  log lines carry real ids when something routes through it. Micrometer Tracing is a facade;
		  this is the OpenTelemetry bridge (NOT Brave), and the Zipkin exporter ships finished spans
		  to the Zipkin in compose.yaml (port 9411). Versions are managed by the Spring Boot parent —
		  no pin here. See docs/concepts/observability.md.
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-otel</artifactId>
		</dependency>
		<dependency>
			<groupId>io.opentelemetry</groupId>
			<artifactId>opentelemetry-exporter-zipkin</artifactId>
		</dependency>
		<!--
		  Boot 4's tracing auto-configuration ships in its own artifact (it was split out of the
		  actuator jar): without it the bridge+exporter above sit on the classpath but no Tracer bean
		  is created and %X{traceId} stays empty. This is the targeted auto-config module (NOT
		  spring-boot-starter-opentelemetry, which would drag in an OTLP exporter and registry we do
		  not use — we ship spans to Zipkin).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
		</dependency>
		<!--
		  The Zipkin *sender*. The auto-config above only builds the ZipkinSpanExporter when a
		  BytesMessageSender bean already exists (@ConditionalOnBean) — and in Boot 4 that bean comes
		  from this separate module, which reads management.zipkin.tracing.endpoint and wires the
		  okhttp sender. Without it the condition silently never matches: spans are still recorded and
		  %X{traceId} still fills in, but nothing is ever shipped and Zipkin stays empty. Having
		  zipkin-sender-okhttp3 on the classpath transitively is NOT enough — a library is not a bean.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-zipkin</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!--
	  Repackages the module into a runnable "fat" jar (the plugin's config — Lombok
	  exclude etc. — is inherited from the parent's pluginManagement). Safe now that a
	  @SpringBootApplication main class exists for the repackage goal to find.
	-->
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
