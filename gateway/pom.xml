<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.gr74</groupId>
		<artifactId>screenmaster-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>gateway</artifactId>
	<name>gateway</name>
	<description>API gateway — single front door, routes to services via lb://.</description>

	<!--
	  The edge. Spring Cloud Gateway (webmvc flavour) does the routing; the Eureka
	  CLIENT lets it resolve lb://catalog etc. No JPA here — the gateway owns no data.
	  Routes + edge auth arrive in Phase 1 (1.3) / Phase 7.
	-->
	<dependencies>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-gateway-server-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>
		<!--
		  Phase 7 (BUILD_PLAN 7.2): the gateway is an OAuth2 resource server — it validates the
		  user's Bearer JWT (signature via Keycloak's JWKS, plus expiry + issuer) before routing.
		  Every backend service validates AGAIN (zero trust); the edge check just fails fast.
		  Version managed by the Spring Boot parent. See docs/concepts/security-jwt-oauth2.md.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>
		<!--
		  Actuator for /actuator/health — the gateway is the front door and needs a health surface
		  for probes and Compose healthchecks (default instrumentation only).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!--
		  Distributed tracing. The gateway is where traces are born (it is
		  the only public entry point), so it gets the same starter as everyone else. Micrometer
		  Tracing is a facade; this is the OpenTelemetry bridge (NOT Brave), and the Zipkin exporter
		  ships finished spans to the Zipkin in compose.yaml (port 9411). Versions are managed by the
		  Spring Boot parent — no pin here. See docs/concepts/observability.md.
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-otel</artifactId>
		</dependency>
		<dependency>
			<groupId>io.opentelemetry</groupId>
			<artifactId>opentelemetry-exporter-zipkin</artifactId>
		</dependency>
		<!--
		  Boot 4's tracing auto-configuration ships in its own artifact (it was split out of the
		  actuator jar): without it the bridge+exporter above sit on the classpath but no Tracer bean
		  is created and %X{traceId} stays empty. This is the targeted auto-config module (NOT
		  spring-boot-starter-opentelemetry, which would drag in an OTLP exporter and registry we do
		  not use — we ship spans to Zipkin).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
		</dependency>
		<!--
		  The Zipkin *sender*. The auto-config above only builds the ZipkinSpanExporter when a
		  BytesMessageSender bean already exists (@ConditionalOnBean) — and in Boot 4 that bean comes
		  from this separate module, which reads management.zipkin.tracing.endpoint and wires the
		  okhttp sender. Without it the condition silently never matches: spans are still recorded and
		  %X{traceId} still fills in, but nothing is ever shipped and Zipkin stays empty. Having
		  zipkin-sender-okhttp3 on the classpath transitively is NOT enough — a library is not a bean.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-zipkin</artifactId>
		</dependency>

		<!--
		  The gateway hosts the ONE aggregated Swagger UI (it has no controllers of its own to
		  document). Each backend service serves its own /v3/api-docs; the gateway UI is configured
		  with a dropdown of those spec URLs (springdoc.swagger-ui.urls in application.yml), proxied
		  through the gateway so the browser fetches them same-origin. See concepts/openapi-springdoc.md.
		-->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  Phase 7: spring-security-test provides the jwt() MockMvc post-processor, so slice tests
		  exercise the REAL filter chain with a forged JWT instead of bypassing security.
		-->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  Boot 4 moved TestRestTemplate out of spring-boot-test into this module
		  (org.springframework.boot.resttestclient.TestRestTemplate) — the Boot-3 import path no
		  longer exists. Used by the full-context actuator/health tests (real HTTP, no MockMvc).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-resttestclient</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!--
	  Repackages the module into a runnable jar (Lombok-exclude config inherited from the
	  parent's pluginManagement). Safe now that GatewayApplication exists (added in 1.3).
	-->
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
