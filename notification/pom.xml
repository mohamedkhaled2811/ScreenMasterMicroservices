<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.gr74</groupId>
		<artifactId>screenmaster-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>notification</artifactId>
	<name>notification</name>
	<description>Notification service — consumes BookingConfirmed, "sends" the email.</description>

	<!--
	  A pure event consumer: it listens for BookingConfirmed off RabbitMQ and "sends"
	  an email (a log line). It dedupes via a processed_events table, so it gets JPA
	  + Postgres in Phase 4 (4.3). For now it only needs to register with Eureka; AMQP
	  + the idempotent-consumer wiring arrive in Phase 4.
	-->
	<dependencies>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!--
	  No spring-boot-maven-plugin yet: no @SpringBootApplication exists, so repackage would
	  fail. The plugin + boot app arrive in Phase 1; for now this builds as a plain jar.
	-->

</project>
