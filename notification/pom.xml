<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.gr74</groupId>
		<artifactId>screenmaster-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>notification</artifactId>
	<name>notification</name>
	<description>Notification service — consumes BookingConfirmed, "sends" the email.</description>

	<!--
	  A pure event consumer (BUILD_PLAN 4.3): it listens for BookingConfirmed / BookingConfirmationRejected
	  off RabbitMQ and "sends" the email (a log line), deduping via a processed_events table — the
	  idempotent-consumer pattern. The AMQP + JPA + Postgres this comment once deferred to "Phase 4
	  (4.3)" are now HERE.

	  Why web-mvc? A Eureka client still needs a port to advertise and /actuator/health needs a servlet
	  container, so web-mvc stays purely for the health surface + advertised port; the consumer wiring
	  (amqp + jpa) layers on top of it. See docs/concepts/idempotent-consumer.md.
	-->
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!--
		  Distributed tracing. Micrometer Tracing is a facade; this is the
		  OpenTelemetry bridge (NOT Brave — the vendor-neutral standard, see docs/concepts/observability.md),
		  and the Zipkin exporter ships finished spans to the Zipkin in compose.yaml (port 9411).
		  The log pattern already carries %X{traceId}/%X{spanId}; these jars are what make
		  the ids appear. Versions are managed by the Spring Boot parent (micrometer-tracing + OTel
		  BOMs) — no pin here.
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-otel</artifactId>
		</dependency>
		<dependency>
			<groupId>io.opentelemetry</groupId>
			<artifactId>opentelemetry-exporter-zipkin</artifactId>
		</dependency>
		<!--
		  Boot 4's tracing auto-configuration ships in its own artifact (it was split out of the
		  actuator jar): without it the bridge+exporter above sit on the classpath but no Tracer bean
		  is created and %X{traceId} stays empty. This is the targeted auto-config module (NOT
		  spring-boot-starter-opentelemetry, which would drag in an OTLP exporter and registry we do
		  not use — we ship spans to Zipkin).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
		</dependency>
		<!--
		  The Zipkin *sender*. The auto-config above only builds the ZipkinSpanExporter when a
		  BytesMessageSender bean already exists (@ConditionalOnBean) — and in Boot 4 that bean comes
		  from this separate module, which reads management.zipkin.tracing.endpoint and wires the
		  okhttp sender. Without it the condition silently never matches: spans are still recorded and
		  %X{traceId} still fills in, but nothing is ever shipped and Zipkin stays empty. Having
		  zipkin-sender-okhttp3 on the classpath transitively is NOT enough — a library is not a bean.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-zipkin</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>

		<!--
		  Phase 7 (BUILD_PLAN 7.3): zero trust extends to the consumer too — Notification validates
		  a Bearer JWT like every other service (today that only gates the actuator surface; the
		  business path is the broker, which carries no token by design). Version managed by the
		  Spring Boot parent. See docs/concepts/security-jwt-oauth2.md.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>

		<!--
		  Phase 7 (BUILD_PLAN 7.6, decision B3a): the machine token. Notification acts AS ITSELF on
		  background threads (no user is waiting), so it authenticates to Keycloak with its own
		  client id/secret (client-credentials grant) — e.g. to look up a user's email by `sub` in
		  part 2. The framework's OAuth2AuthorizedClientManager fetches, caches and refreshes the
		  token; we never hand-roll a token cache. See docs/concepts/security-jwt-oauth2.md.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-client</artifactId>
		</dependency>

		<!--
		  AMQP / RabbitMQ. Notification is the CONSUMER side of Booking's booking-outcome stream
		  (BUILD_PLAN 4.3): a @RabbitListener consumes BookingConfirmed / BookingConfirmationRejected
		  and "sends" the email. Version managed by the Spring Boot parent.
		  See docs/concepts/rabbitmq.md, docs/concepts/idempotent-consumer.md.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>

		<!--
		  JavaMail. The actual SEND: JavaMailSender talks SMTP to whatever spring.mail.host points at
		  — Mailpit in Compose, a real provider (SES/SendGrid) in production via env vars only, with
		  NO code change. This is what turns NotificationService's log.info into a real side effect.
		  See docs/concepts/notification-channels.md.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<!--
		  Thymeleaf renders the ticket HTML. Used here as a STANDALONE template engine (no web MVC
		  view resolution): EmailChannel builds a Context of variables and calls process() to get a
		  String body. Keeping the email copy in a template instead of a Java text block is what lets
		  the ticket markup — which is table-based, inline-styled HTML-email markup, not modern CSS —
		  be edited without recompiling logic. See docs/concepts/html-email-rendering.md.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<!--
		  Caffeine backs the @Cacheable on the Keycloak email lookup. A user's email changes rarely,
		  but the lookup sits on the consume path of EVERY booking event — so without a cache this
		  service hammers the IdP once per booking and a brief Keycloak blip fails sends that had no
		  need to touch it. Spring's cache abstraction picks Caffeine up automatically when it is on
		  the classpath. See docs/concepts/notification-channels.md.
		-->
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>

		<!--
		  JPA persistence for the processed_events dedupe table (the claim that makes the consumer
		  idempotent). Schema owned by Liquibase, ddl-auto=validate — never ddl-auto=update.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!--
		  Spring Boot 4 moved each integration's auto-configuration out of the umbrella
		  spring-boot-autoconfigure jar into its own module. spring-boot-liquibase carries
		  LiquibaseAutoConfiguration (the bean that runs the changelog on startup) and pulls in
		  liquibase-core transitively. Without it, liquibase-core is on the classpath but never
		  runs — the schema is never created and Hibernate's ddl-auto=validate fails with
		  "missing table [...]". See docs/concepts/liquibase.md.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-liquibase</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  Boot 4 moved TestRestTemplate out of spring-boot-test into this module
		  (org.springframework.boot.resttestclient.TestRestTemplate) — the Boot-3 import path no
		  longer exists. Used by the full-context actuator/health tests (real HTTP, no MockMvc).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-resttestclient</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  COMPILE scope as of 4.3b — it was test-only, and the comment here said "Part 2's Keycloak
		  Admin API lookup will add the real client then". This is then: KeycloakUserClient resolves
		  the ticket's recipient from Keycloak's Admin API, so RestClient is now a main-source
		  dependency, not a test fixture.
		  Boot 4 split RestClient out of the web starter into its own module, so without this entry it
		  is on the main classpath only TRANSITIVELY — which compiles, but auto-configures nothing.
		  That is precisely how the first container boot failed: "No qualifying bean of type
		  'RestClient$Builder'". The client is built explicitly in KeycloakClientConfig (with
		  timeouts, and deliberately not as a builder bean — see that class), and this starter is what
		  puts ClientHttpRequestFactoryBuilder / HttpClientSettings on the main classpath to do it.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-restclient</artifactId>
		</dependency>
		<!--
		  Spring Boot 4 split the test slices out of spring-boot-test-autoconfigure into per-technology
		  modules; spring-boot-data-jpa-test carries @DataJpaTest and pulls in TestEntityManager (the
		  repository slices). Without it the slice annotation isn't on the classpath. Mirrors booking.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- TEST SCOPE ONLY: in-memory DB so the hermetic suite needs no running Postgres. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!--
	  Repackages the module into a runnable jar (Lombok-exclude config inherited from the
	  parent's pluginManagement). Safe now that NotificationApplication exists.
	-->
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
