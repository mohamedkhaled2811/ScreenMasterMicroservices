<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.gr74</groupId>
		<artifactId>screenmaster-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>payment</artifactId>
	<name>payment</name>
	<description>Fake payment provider — controllable FAIL_RATE, no database.</description>

	<!--
	  A deliberately fake provider we control: it returns 200 after ~300ms and fails
	  at a configurable FAIL_RATE so we can exercise the saga's compensation (Phase 3)
	  and Booking's circuit breaker (Phase 5). No JPA — it owns no data. REST + Eureka
	  only. The endpoint + FAIL_RATE land in Phase 1 (1.2).
	-->
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!--
	  No spring-boot-maven-plugin yet: no @SpringBootApplication exists, so repackage would
	  fail. The plugin + boot app arrive in Phase 1; for now this builds as a plain jar.
	-->

</project>
