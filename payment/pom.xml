<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.gr74</groupId>
		<artifactId>screenmaster-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>payment</artifactId>
	<name>payment</name>
	<description>Fake payment provider — controllable FAIL_RATE, idempotent, persists charges.</description>

	<!--
	  A deliberately fake provider we control: POST /payments returns 200 after ~300ms and
	  declines at a configurable FAIL_RATE, so we can exercise the saga's compensation (Phase 3)
	  and Booking's circuit breaker (Phase 5). The fake logic sits behind a PaymentProvider
	  interface (@Profile("!real")) so a real StripePaymentProvider is an add-only swap later.
	  It owns its own Postgres (payment-db) and persists every charge with an idempotency key
	  (UNIQUE) so a retried POST replays the original result instead of charging twice — hence
	  JPA + Liquibase here. Schema is managed by Liquibase with ddl-auto=validate.
	-->
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>

		<!--
		  Spring Boot 4 moved each integration's auto-configuration out of the umbrella
		  spring-boot-autoconfigure jar into its own module. spring-boot-liquibase carries
		  LiquibaseAutoConfiguration (the bean that runs the changelog on startup) and pulls in
		  liquibase-core transitively. Without it, liquibase-core is on the classpath but never
		  runs — the schema is never created and Hibernate's ddl-auto=validate fails with
		  "missing table [payments]". See docs/concepts/liquibase.md.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-liquibase</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  TEST SCOPE ONLY: an in-memory database for the hermetic contextLoads test, so it needs no
		  running Postgres. The shipped app always uses Postgres + Liquibase (see application.yml);
		  H2 never reaches a jar. The test profile points at H2 and lets Hibernate create-drop the
		  schema (Liquibase is disabled there).
		-->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!--
	  Repackages the module into a runnable jar (Lombok-exclude config inherited from the
	  parent's pluginManagement). Safe now that PaymentApplication exists for the repackage goal.
	-->
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
