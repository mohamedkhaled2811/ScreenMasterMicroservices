<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	  PARENT (aggregator) POM for the ScreenMaster microservices.
	  - packaging=pom: this module builds no code; it aggregates the child modules
	    (the Maven "reactor") and centralises dependency/plugin versions.
	  - Each child service has its own pom.xml that declares parent = this file and
	    pulls ONLY the starters it actually needs (see concepts/maven-multi-module.md).
	  We still inherit spring-boot-starter-parent for sane dependency/plugin defaults.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.gr74</groupId>
	<artifactId>screenmaster-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>ScreenMaster Microservices (parent)</name>
	<description>Parent POM aggregating the ScreenMaster microservices.</description>

	<modules>
		<module>discovery</module>
		<module>gateway</module>
		<module>catalog</module>
		<module>booking</module>
		<module>payment</module>
		<module>notification</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<spring-cloud.version>2025.1.2</spring-cloud.version>
		<!--
		  springdoc-openapi: introspects controllers + DTOs at runtime to serve an OpenAPI 3.1
		  spec and Swagger UI. The v3 line targets Spring Boot 4 (3.0.3 is built on
		  spring-boot-starter-parent 4.0.5); the 2.8.x line is Spring Boot 3 only. Pinned here
		  so each service declares the starter without a version. See concepts/openapi-springdoc.md.
		-->
		<springdoc.version>3.0.3</springdoc.version>
		<!--
		  JaCoCo: bytecode instrumentation agent + coverage reporter. 0.8.13+ is required for
		  Java 21 class files; Spring Boot 4.1.0's parent does not manage this version.
		  See docs/concepts/ci-and-coverage.md.
		-->
		<jacoco.version>0.8.13</jacoco.version>
	</properties>

	<!--
	  dependencyManagement = versions only; no dependencies are pulled here.
	  Children list deps WITHOUT versions; the version is resolved from here.
	  This keeps each service's classpath lean and its boundary honest.
	-->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- OpenAPI/Swagger UI starter (servlet). Children add it version-free. -->
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
				<version>${springdoc.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<!--
		  pluginManagement = plugin config inherited by children that declare the plugin.
		  We pin the Lombok annotation-processor path on the compiler plugin so every
		  service compiles Lombok the same way, and exclude Lombok from the repackaged jar.
		-->
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
					<configuration>
						<excludes>
							<exclude>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
							</exclude>
						</excludes>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>

		<!--
		  Plugins inherited by every module. JaCoCo instruments tests and produces coverage
		  reports for each service without repeating the configuration in child poms.
		-->
		<plugins>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
